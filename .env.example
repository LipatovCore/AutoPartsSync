# Local development template. Copy to `.env` and replace every placeholder.
DJANGO_ENV=local
DJANGO_SECRET_KEY=replace-this-secret-before-running
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# External integrations
ABCP_URL=example.abcp.local
ABCP_USER=example-user
ABCP_PASS=replace-abcp-password
MS_TOKEN=replace-moysklad-token
